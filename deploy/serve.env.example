# s4000-moe-engine service environment.
# Copy to /etc/s4000-moe/serve.env and edit. chmod 600.

# Required: model directory containing config.json + tokenizer files.
NANOVLLM_MODEL=/models/Qwen3-30B-A3B-Instruct-2507-FP8
NANOVLLM_SERVED_MODEL_NAME=qwen3-30b-a3b

# Network. Keep 127.0.0.1 unless a reverse proxy/API key is configured.
NANOVLLM_HOST=127.0.0.1
NANOVLLM_PORT=8000
# Required for a non-loopback bind (e.g. 0.0.0.0).
NANOVLLM_API_KEY=

# Parallelism / memory. For a single-card 0.6B smoke set TP_SIZE=1 EP_SIZE=1.
NANOVLLM_TP_SIZE=2
NANOVLLM_EP_SIZE=2
NANOVLLM_GPU_MEM_UTIL=0.9
NANOVLLM_MAX_MODEL_LEN=4096

# Production kernel/scheduler stack (defaults; keep unless debugging).
NANOVLLM_MOE_BACKEND=grouped_mm
NANOVLLM_DECODE_MOE_BACKEND=bmm_dense
NANOVLLM_ATTENTION_BACKEND=triton_paged
NANOVLLM_SCHEDULER_POLICY=stall_free
NANOVLLM_PREFILL_CHUNK_SIZE=256
NANOVLLM_ENFORCE_EAGER=1

# Optional service limits.
NANOVLLM_MAX_NUM_SEQS=512
NANOVLLM_MAX_QUEUE_SIZE=1024
NANOVLLM_LOG_LEVEL=info

# Only for a trusted private network with no API key. Prefer an API key.
NANOVLLM_ALLOW_INSECURE=0