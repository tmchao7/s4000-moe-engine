[Unit]
Description=s4000-moe-engine OpenAI-compatible inference server
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=@USER@
Group=@USER@
WorkingDirectory=@APP_DIR@
EnvironmentFile=/etc/s4000-moe/serve.env
Environment=PYTHONUNBUFFERED=1
Environment=S4000_VENV=@VENV@
Environment=S4000_BIN=@BIN@
Environment=S4000_ENV_FILE=/etc/s4000-moe/serve.env
ExecStart=@APP_DIR@/scripts/serve_s4000.sh
Restart=on-failure
RestartSec=10
StartLimitBurst=5
TimeoutStartSec=1800
TimeoutStopSec=180
KillSignal=SIGTERM
KillMode=mixed
LimitNOFILE=65535
NoNewPrivileges=true
StandardOutput=journal
StandardError=journal
SyslogIdentifier=s4000-moe

[Install]
WantedBy=multi-user.target